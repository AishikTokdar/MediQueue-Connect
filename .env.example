# ==============================================================================
# MediQueue Connect - Environment Configuration Template
# Copy this file to '.env' and adjust the values according to your environment.
# ==============================================================================

# ------------------------------------------------------------------------------
# 1. Health Server (Asyncio TCP & TLS Control Plane)
# ------------------------------------------------------------------------------
# Host interface the Health Server socket binds to.
# Use 0.0.0.0 in Docker or production; use 127.0.0.1 for local single-machine testing.
HEALTH_SERVER_BIND_HOST=0.0.0.0

# TCP port for the Health Server socket RPC listener.
HEALTH_SERVER_PORT=4000

# ------------------------------------------------------------------------------
# 2. Client & Tool Target Address
# ------------------------------------------------------------------------------
# Target hostname or IP where clients (patient, doctor, admin, dashboard, gateway)
# connect to reach the Health Server.
# In local development: 127.0.0.1
# In Docker Compose: health_server
HEALTH_SERVER_HOST=127.0.0.1

# ------------------------------------------------------------------------------
# 3. Security & Cryptographic Salts
# ------------------------------------------------------------------------------
# Cryptographic salt for fallback password hashing (Argon2id uses internal dynamic salts).
MEDIQUEUE_SALT=mediqueue_salt_2026

# ------------------------------------------------------------------------------
# 4. Redis In-Memory Cache & Pub/Sub Event Bus
# ------------------------------------------------------------------------------
# Redis host and port for ephemeral session token caching and broadcast synchronization.
# In local development: 127.0.0.1
# In Docker Compose: redis
REDIS_HOST=127.0.0.1
REDIS_PORT=6379

# Full Redis connection URL for Celery task result backend and Pub/Sub subscriptions.
# In local development: redis://127.0.0.1:6379/0
# In Docker Compose: redis://redis:6379/0
REDIS_URL=redis://127.0.0.1:6379/0

# ------------------------------------------------------------------------------
# 5. Distributed Task Queue (RabbitMQ & Celery)
# ------------------------------------------------------------------------------
# AMQP connection URL for RabbitMQ message broker.
# In local development: amqp://guest:guest@127.0.0.1:5672//
# In Docker Compose: amqp://guest:guest@rabbitmq:5672//
RABBITMQ_URL=amqp://guest:guest@127.0.0.1:5672//

# Execute Celery tasks synchronously in-process without an external broker.
# Set to 'true' for standalone local dev without RabbitMQ/Redis; 'false' for production.
CELERY_ALWAYS_EAGER=false

# ------------------------------------------------------------------------------
# 6. WebSocket API Gateway Bridge
# ------------------------------------------------------------------------------
# Interface and port for the FastAPI / Uvicorn WebSocket bridge service.
WS_BIND_HOST=0.0.0.0
WS_PORT=8080

# ------------------------------------------------------------------------------
# 7. Performance Benchmarking Tool
# ------------------------------------------------------------------------------
# Port for the comparative UDP echo server latency benchmark.
UDP_ECHO_PORT=5999

